OPENCODE_URL=http://127.0.0.1:4096
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=
OPENCODE_MODEL=openrouter/qwen/qwen3.8-max-0902
OPENCODE_MODEL_1=openrouter/x-ai/grok-4.7:high
OPENCODE_MODEL_2=openrouter/x-ai/grok-4.7:xhigh
OPENCODE_ENABLED=1
# Секунды ожидания ответа модели. 0 = ждать без обрыва (по умолчанию).
OPENCODE_TIMEOUT_S=0
OPENROUTER_API_KEY=
OPENROUTER_MANAGEMENT_KEY=
# Исходники для модели (Ubuntu update-сайт). Локально по умолчанию backend/data/model_inputs.
MODEL_INPUTS_ROOT=/opt/files_transformer_update/data/model_inputs
MODEL_INPUTS_TTL_H=24
# 1 = старый known-skip без модели (только отладка). По умолчанию модель всегда.
ALLOW_SKIP_MODEL=0
VERDICT_PROMPT=full
