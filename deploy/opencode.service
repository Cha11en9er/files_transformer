[Unit]
Description=OpenCode model server for customs workspace
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/files_transformer
EnvironmentFile=-/opt/files_transformer/backend/.env
Environment=HOME=/root
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/root/.opencode/bin:/root/.local/bin
ExecStart=/usr/bin/env opencode serve --hostname 127.0.0.1 --port 4096
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
